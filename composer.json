{
    "name": "phpstats/phiz",
    "description": "A ggplot2-flavored grammar of graphics for PHP that emits Vega-Lite",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "visualization",
        "vega-lite",
        "ggplot2",
        "grammar of graphics",
        "charts",
        "statistics"
    ],
    "authors": [
        {
            "name": "Erik Westlund"
        }
    ],
    "require": {
        "php": "^8.3",
        "ext-json": "*"
    },
    "require-dev": {
        "opis/json-schema": "^2.4",
        "orchestra/testbench": "^10.0",
        "pestphp/pest": "^4.0",
        "phpstats/phibble": "^0.3",
        "phpstats/phit-polyfill": "dev-main",
        "phpstats/phplyr": "^0.3",
        "squizlabs/php_codesniffer": "^3.13"
    },
    "suggest": {
        "illuminate/view": "For the <x-phiz> Blade component (auto-discovered in Laravel)",
        "phpstats/phibble": "Data frames that phiz plots directly",
        "phpstats/phit-polyfill": "Formula predictions (effect_plot, marginal_means) without the phit extension"
    },
    "autoload": {
        "psr-4": {
            "Phiz\\": "src/"
        },
        "files": [
            "src/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Phiz\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Phiz\\Laravel\\PhizServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "pest",
        "gallery": "php examples/gallery.php",
        "lint": [
            "phpcs",
            "@test:sniffs"
        ],
        "test:sniffs": "php tools/phpcs/selftest/run.php"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/phpstats/phibble"
        },
        {
            "type": "vcs",
            "url": "https://github.com/phpstats/phplyr"
        },
        {
            "type": "vcs",
            "url": "https://github.com/phpstats/phit-polyfill"
        }
    ]
}
