{
    "name": "erikwestlund/phit",
    "description": "A ggplot2-flavored grammar of graphics for PHP that emits Vega-Lite",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "visualization",
        "vega-lite",
        "ggplot2",
        "grammar of graphics",
        "charts",
        "statistics"
    ],
    "authors": [
        {
            "name": "Erik Westlund"
        }
    ],
    "require": {
        "php": "^8.5",
        "ext-json": "*"
    },
    "require-dev": {
        "erikwestlund/phibble": "dev-main",
        "erikwestlund/phplyr": "dev-main",
        "opis/json-schema": "^2.4",
        "orchestra/testbench": "^10.0",
        "pestphp/pest": "^4.0"
    },
    "suggest": {
        "erikwestlund/phibble": "Data frames that phit plots directly",
        "illuminate/view": "For the <x-phit> Blade component (auto-discovered in Laravel)"
    },
    "autoload": {
        "psr-4": {
            "Phit\\": "src/"
        },
        "files": [
            "src/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Phit\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Phit\\Laravel\\PhitServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "pest",
        "gallery": "php examples/gallery.php"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/erikwestlund/phibble"
        },
        {
            "type": "vcs",
            "url": "https://github.com/erikwestlund/phplyr"
        }
    ]
}
