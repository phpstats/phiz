                "manufacturer": "audi",
                "model": "a4",
                "displ": 1.8,
                "year": 1999,
                "cyl": 4,
                "trans": "auto(l5)",
                "drv": "f",
                "cty": 18,
                "hwy": 29,
                "fl": "p",
                "class": "compact"
            },
            {
                "manufacturer": "audi",
                "model": "a4",
                "displ": 1.8,
                "year": 1999,
                "cyl": 4,
                "trans": "manual(m5)",
                "drv": "f",
                "cty": 21,
                "hwy": 29,
                "fl": "p",
                "class": "compact"
            },
            {
                "manufacturer": "audi",
                "model": "a4",
                "displ": 2,
                "year": 2008,
                "cyl": 4,
                "trans": "manual(m6)",
                "drv": "f",
                "cty": 20,
                "hwy": 31,
                "fl": "p",
                "class": "compact"
            },
            "... 231 more rows"
        ]
    },
    "facet": {
        "row": {
            "field": "drv",
            "type": "nominal",
            "title": null,
            "header": {
                "labelAngle": 0,
                "labelAlign": "left",
                "labelOrient": "right"
            }
        },
        "column": {
            "field": "year",
            "type": "ordinal",
            "title": null
        }
    },
    "spec": {
        "width": 200,
        "height": 120,
        "layer": [
            {
                "mark": {
                    "type": "point",
                    "filled": true,
                    "opacity": 0.5
                },
                "encoding": {
                    "x": {
                        "field": "cty",
                        "type": "quantitative",
                        "scale": {
                            "zero": false
                        }
                    },
                    "y": {
                        "field": "hwy",
                        "type": "quantitative",
                        "scale": {
                            "zero": false
                        }
                    }
                }
            },
            {
                "transform": [
                    {
                        "aggregate": [
                            {
                                "op": "min",
                                "field": "cty",
                                "as": "__x1"
                            },
                            {
                                "op": "max",
                                "field": "cty",
                                "as": "__x2"
                            }
                        ],
                        "groupby": [
                            "drv",
                            "year"
                        ]
                    },
                    {
                        "calculate": "0 + 1 * datum.__x1",
                        "as": "__y1"
                    },
                    {
                        "calculate": "0 + 1 * datum.__x2",
                        "as": "__y2"
                    }
                ],
                "mark": {
                    "type": "rule",
                    "color": "#888888",
                    "strokeDash": [
                        4,
                        4
                    ]
                },
                "encoding": {
                    "x": {
                        "field": "__x1",
                        "type": "quantitative",
                        "title": "cty",
                        "scale": {
                            "zero": false
                        }
                    },
                    "x2": {
                        "field": "__x2"
                    },
                    "y": {
                        "field": "__y1",
                        "type": "quantitative",
                        "title": "hwy",
                        "scale": {
                            "zero": false
                        }
                    },
                    "y2": {
                        "field": "__y2"
                    }
                }
            }
        ]
    }
}
