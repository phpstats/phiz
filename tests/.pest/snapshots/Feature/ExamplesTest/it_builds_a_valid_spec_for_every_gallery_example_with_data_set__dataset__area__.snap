                "pop": 8425333,
                "gdpPercap": 779.4453145
            },
            {
                "country": "Afghanistan",
                "continent": "Asia",
                "year": 1957,
                "lifeExp": 30.332,
                "pop": 9240934,
                "gdpPercap": 820.8530296
            },
            {
                "country": "Afghanistan",
