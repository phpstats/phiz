    "transform": [
        {
            "window": [
                {
                    "op": "cume_dist",
                    "as": "ecdf"
                }
            ],
            "sort": [
                {
                    "field": "cty"
                }
            ],
            "groupby": [
                "drv"
            ]
        }
    ],
    "mark": {
        "type": "line",
        "interpolate": "step-after"
    },
    "encoding": {
        "x": {
            "field": "cty",
            "type": "quantitative",
            "title": "City mpg",
            "scale": {
                "zero": false
            }
        },
        "color": {
            "field": "drv",
            "type": "nominal",
            "title": "Drive"
        },
        "y": {
            "field": "ecdf",
            "type": "quantitative",
            "title": "Proportion ≤ x",
            "scale": {
                "zero": false
            }
        }
    },
    "config": {
        "legend": {
            "labelLimit": 320
        }
    }
}
