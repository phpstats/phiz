{
    "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
    "data": {
        "values": [
            {
                "eruptions": 3.6,
                "waiting": 79
            },
            {
                "eruptions": 1.8,
                "waiting": 54
            },
            {
                "eruptions": 3.333,
                "waiting": 74
            },
            "... 269 more rows"
        ]
    },
    "layer": [
        {
            "transform": [
                {
                    "bin": {
                        "step": 0.25
                    },
                    "field": "eruptions",
                    "as": [
                        "__bin_start",
                        "__bin_end"
                    ]
                },
                {
                    "aggregate": [
                        {
                            "op": "count",
                            "as": "__count"
                        }
                    ],
                    "groupby": [
                        "__bin_start",
                        "__bin_end"
                    ]
                },
                {
                    "joinaggregate": [
                        {
                            "op": "sum",
                            "field": "__count",
                            "as": "__total"
                        }
                    ],
                    "groupby": []
                },
                {
                    "calculate": "datum.__count / datum.__total / (datum.__bin_end - datum.__bin_start)",
                    "as": "density"
                }
            ],
            "mark": {
                "type": "bar",
                "fill": "#DDDDDD",
                "stroke": "#999999"
            },
            "encoding": {
                "x": {
                    "field": "__bin_start",
                    "type": "quantitative",
                    "bin": {
                        "binned": true
                    },
                    "title": "Eruption length (minutes)"
                },
                "x2": {
                    "field": "__bin_end"
                },
                "y": {
                    "field": "density",
                    "type": "quantitative",
                    "title": "density"
                }
            }
        },
        {
            "transform": [
                {
                    "density": "eruptions",
                    "as": [
                        "eruptions",
                        "density"
                    ]
                }
            ],
            "mark": {
                "type": "line",
                "color": "#D62728",
                "strokeWidth": 2
            },
            "encoding": {
                "x": {
                    "field": "eruptions",
                    "type": "quantitative",
                    "title": "Eruption length (minutes)"
                },
                "y": {
                    "field": "density",
                    "type": "quantitative",
                    "title": "density"
                }
            }
        }
    ],
    "config": {
        "axisQuantitative": {
            "tickCount": 5
        },
        "style": {
            "phiz-fit": {
                "color": "#3366FF"
            },
            "phiz-band": {
                "color": "#999999",
                "opacity": 0.4
            }
        }
    },
    "usermeta": {
        "phiz": {
            "dark": {
                "background": "transparent",
                "view": {
                    "fill": null,
                    "stroke": "#3F3F46"
                },
                "axis": {
                    "gridColor": "rgba(255, 255, 255, 0.12)",
                    "gridOpacity": 1,
                    "domainColor": "#71717A",
                    "tickColor": "#71717A",
                    "labelColor": "#A1A1AA",
                    "titleColor": "#E4E4E7"
                },
                "legend": {
                    "labelColor": "#E4E4E7",
                    "titleColor": "#E4E4E7"
                },
                "header": {
                    "labelColor": "#E4E4E7",
                    "titleColor": "#E4E4E7"
                },
                "title": {
                    "color": "#E4E4E7",
                    "subtitleColor": "#A1A1AA"
                },
                "mark": {
                    "color": "#8AB4F8"
                },
                "point": {
                    "color": "#8AB4F8"
                },
                "line": {
                    "color": "#8AB4F8"
                },
                "text": {
                    "color": "#E4E4E7"
                },
                "rule": {
                    "color": "#A1A1AA"
                },
                "style": {
                    "phiz-fit": {
                        "color": "#A5C8FF"
                    },
                    "phiz-band": {
                        "color": "#FFFFFF",
                        "opacity": 0.16
                    }
                }
            }
        }
    }
}
