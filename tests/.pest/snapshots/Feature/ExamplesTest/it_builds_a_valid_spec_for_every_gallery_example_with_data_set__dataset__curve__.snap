{
    "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
    "data": {
        "values": [
            {
                "manufacturer": "audi",
                "model": "a4",
                "displ": 1.8,
                "year": 1999,
                "cyl": 4,
                "trans": "auto(l5)",
                "drv": "f",
                "cty": 18,
                "hwy": 29,
                "fl": "p",
                "class": "compact"
            },
            {
                "manufacturer": "audi",
                "model": "a4",
                "displ": 1.8,
                "year": 1999,
                "cyl": 4,
                "trans": "manual(m5)",
                "drv": "f",
                "cty": 21,
                "hwy": 29,
                "fl": "p",
                "class": "compact"
            },
            {
                "manufacturer": "audi",
                "model": "a4",
                "displ": 2,
                "year": 2008,
                "cyl": 4,
                "trans": "manual(m6)",
                "drv": "f",
                "cty": 20,
                "hwy": 31,
                "fl": "p",
                "class": "compact"
            },
            "... 231 more rows"
        ]
    },
    "layer": [
        {
            "transform": [
                {
                    "bin": {
                        "step": 2
                    },
                    "field": "hwy",
                    "as": [
                        "__bin_start",
                        "__bin_end"
                    ]
                },
                {
                    "aggregate": [
                        {
                            "op": "count",
                            "as": "__count"
                        }
                    ],
                    "groupby": [
                        "__bin_start",
                        "__bin_end"
                    ]
                },
                {
                    "joinaggregate": [
                        {
                            "op": "sum",
                            "field": "__count",
                            "as": "__total"
                        }
                    ],
                    "groupby": []
                },
                {
                    "calculate": "datum.__count / datum.__total / (datum.__bin_end - datum.__bin_start)",
                    "as": "density"
                }
            ],
            "mark": {
                "type": "bar",
                "fill": "#DDDDDD"
            },
            "encoding": {
                "x": {
                    "field": "__bin_start",
                    "type": "quantitative",
                    "bin": {
                        "binned": true
                    },
                    "title": "Highway mpg"
                },
                "x2": {
                    "field": "__bin_end"
                },
                "y": {
                    "field": "density",
                    "type": "quantitative",
                    "title": "Density"
                }
            }
        },
        {
            "data": {
                "values": [
                    {
                        "hwy": 10.0,
                        "density": 0.005245738203061425
                    },
                    {
                        "hwy": 10.36,
                        "density": 0.006001716040568171
                    },
                    {
                        "hwy": 10.72,
                        "density": 0.0068415878245394425
                    },
                    "... 98 more rows"
                ]
            },
            "mark": {
                "type": "line",
                "color": "#D62728",
                "strokeWidth": 2
            },
            "encoding": {
                "x": {
                    "field": "hwy",
                    "type": "quantitative",
                    "title": "Highway mpg"
                },
                "y": {
                    "field": "density",
                    "type": "quantitative",
                    "title": "Density"
                }
            }
        }
    ]
}
