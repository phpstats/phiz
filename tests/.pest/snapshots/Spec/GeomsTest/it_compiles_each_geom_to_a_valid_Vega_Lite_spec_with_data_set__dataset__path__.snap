{
    "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
    "data": {
        "values": [
            {
                "x": 1,
                "y": 2.5,
                "g": "a",
                "h": "p",
                "n": 3,
                "date": "2024-01-01",
                "lo": 2.0,
                "hi": 3.0
            },
            {
                "x": 2,
                "y": 3.1,
                "g": "b",
                "h": "q",
                "n": 5,
                "date": "2024-02-01",
                "lo": 2.6,
                "hi": 3.7
            },
            {
                "x": 3,
                "y": 2.2,
                "g": "a",
                "h": "q",
                "n": 2,
                "date": "2024-03-01",
                "lo": 1.5,
                "hi": 2.9
            },
            "... 3 more rows"
        ]
    },
    "transform": [
        {
            "window": [
                {
                    "op": "row_number",
                    "as": "__order"
                }
            ]
        }
    ],
    "mark": {
        "type": "line"
    },
    "encoding": {
        "x": {
            "field": "y",
            "type": "quantitative",
            "scale": {
                "zero": false
            }
        },
        "y": {
            "field": "x",
            "type": "quantitative",
            "scale": {
                "zero": false
            }
        },
        "order": {
            "field": "__order",
            "type": "quantitative"
        }
    },
    "config": {
        "axis": {
            "labelFontSize": 11,
            "titleFontSize": 12
        },
        "legend": {
            "labelFontSize": 11,
            "titleFontSize": 12
        },
        "header": {
            "labelFontSize": 11,
            "titleFontSize": 12
        },
        "axisQuantitative": {
            "tickCount": 5
        },
        "axisTemporal": {
            "tickCount": 6
        },
        "style": {
            "phiz-fit": {
                "color": "#3366FF"
            },
            "phiz-band": {
                "color": "#999999",
                "opacity": 0.4
            },
            "phiz-outline": {
                "stroke": "#000000"
            },
            "phiz-fill": {
                "fill": "#333333"
            },
            "phiz-inner": {
                "color": "#03396C",
                "stroke": "#03396C"
            },
            "phiz-interval": {
                "color": "#4C78A8"
            }
        },
        "errorbar": {
            "rule": {
                "color": "#4C78A8"
            },
            "ticks": {
                "color": "#4C78A8"
            }
        }
    },
    "usermeta": {
        "phiz": {
            "dark": {
                "background": "transparent",
                "view": {
                    "fill": null,
                    "stroke": "#3F3F46"
                },
                "axis": {
                    "gridColor": "rgba(255, 255, 255, 0.12)",
                    "gridOpacity": 1,
                    "domainColor": "#71717A",
                    "tickColor": "#71717A",
                    "labelColor": "#A1A1AA",
                    "titleColor": "#E4E4E7"
                },
                "legend": {
                    "labelColor": "#E4E4E7",
                    "titleColor": "#E4E4E7"
                },
                "header": {
                    "labelColor": "#E4E4E7",
                    "titleColor": "#E4E4E7"
                },
                "title": {
                    "color": "#E4E4E7",
                    "subtitleColor": "#A1A1AA"
                },
                "mark": {
                    "color": "#8AB4F8"
                },
                "point": {
                    "color": "#8AB4F8"
                },
                "line": {
                    "color": "#8AB4F8"
                },
                "text": {
                    "color": "#E4E4E7"
                },
                "rule": {
                    "color": "#A1A1AA"
                },
                "style": {
                    "phiz-fit": {
                        "color": "#A5C8FF"
                    },
                    "phiz-band": {
                        "color": "#FFFFFF",
                        "opacity": 0.16
                    },
                    "phiz-outline": {
                        "stroke": "#D4D4D8"
                    },
                    "phiz-fill": {
                        "fill": "#D4D4D8"
                    },
                    "phiz-inner": {
                        "color": "#8AB4F8",
                        "stroke": "#8AB4F8"
                    },
                    "phiz-interval": {
                        "color": "#8AB4F8"
                    }
                },
                "errorbar": {
                    "rule": {
                        "color": "#8AB4F8"
                    },
                    "ticks": {
                        "color": "#8AB4F8"
                    }
                },
                "boxplot": {
                    "rule": {
                        "color": "#A1A1AA"
                    },
                    "outliers": {
                        "color": "#A1A1AA"
                    }
                },
                "selection": {
                    "interval": {
                        "mark": {
                            "fill": "#FFFFFF",
                            "fillOpacity": 0.15,
                            "stroke": "#E4E4E7"
                        }
                    }
                },
                "range": {
                    "ramp": {
                        "scheme": "blues",
                        "extent": [
                            0.1,
                            0.75
                        ]
                    },
                    "heatmap": {
                        "scheme": "viridis",
                        "extent": [
                            0.15,
                            1
                        ]
                    },
                    "category": [
                        "#8AB4F8",
                        "#FDBA74",
                        "#F28B82",
                        "#81C995",
                        "#FDD663",
                        "#C58AF9",
                        "#78D9EC",
                        "#FF8BCB",
                        "#E8EAED",
                        "#A8C7FA"
                    ]
                }
            }
        }
    }
}
