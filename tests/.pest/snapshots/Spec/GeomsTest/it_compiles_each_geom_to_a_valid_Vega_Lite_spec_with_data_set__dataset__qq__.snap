{
    "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
    "data": {
        "values": [
            {
                "x": 1,
                "y": 2.5,
                "g": "a",
                "h": "p",
                "n": 3,
                "date": "2024-01-01",
                "lo": 2.0,
                "hi": 3.0
            },
            {
                "x": 2,
                "y": 3.1,
                "g": "b",
                "h": "q",
                "n": 5,
                "date": "2024-02-01",
                "lo": 2.6,
                "hi": 3.7
            },
            {
                "x": 3,
                "y": 2.2,
                "g": "a",
                "h": "q",
                "n": 2,
                "date": "2024-03-01",
                "lo": 1.5,
                "hi": 2.9
            },
            "... 3 more rows"
        ]
    },
    "layer": [
        {
            "transform": [
                {
                    "quantile": "y",
                    "as": [
                        "__prob",
                        "y"
                    ],
                    "step": 0.16666666666666666
                },
                {
                    "calculate": "quantileNormal(datum.__prob)",
                    "as": "theoretical"
                }
            ],
            "mark": {
                "type": "point",
                "filled": true
            },
            "encoding": {
                "x": {
                    "field": "theoretical",
                    "type": "quantitative",
                    "title": "theoretical",
                    "scale": {
                        "zero": false
                    }
                },
                "y": {
                    "field": "y",
                    "type": "quantitative",
                    "title": "y",
                    "scale": {
                        "zero": false
                    }
                }
            }
        },
        {
            "transform": [
                {
                    "quantile": "y",
                    "as": [
                        "__prob",
                        "y"
                    ],
                    "step": 0.16666666666666666
                },
                {
                    "calculate": "quantileNormal(datum.__prob)",
                    "as": "theoretical"
                },
                {
                    "joinaggregate": [
                        {
                            "op": "q1",
                            "field": "y",
                            "as": "__q1"
                        },
                        {
                            "op": "q3",
                            "field": "y",
                            "as": "__q3"
                        }
                    ]
                },
                {
                    "calculate": "(datum.__q3 - datum.__q1) / (quantileNormal(0.75) - quantileNormal(0.25))",
                    "as": "__slope"
                },
                {
                    "calculate": "datum.__q1 - datum.__slope * quantileNormal(0.25)",
                    "as": "__intercept"
                },
                {
                    "aggregate": [
                        {
                            "op": "min",
                            "field": "theoretical",
                            "as": "__x1"
                        },
                        {
                            "op": "max",
                            "field": "theoretical",
                            "as": "__x2"
                        }
                    ],
                    "groupby": [
                        "__slope",
                        "__intercept"
                    ]
                },
                {
                    "calculate": "datum.__intercept + datum.__slope * datum.__x1",
                    "as": "__y1"
                },
                {
                    "calculate": "datum.__intercept + datum.__slope * datum.__x2",
                    "as": "__y2"
                }
            ],
            "mark": {
                "type": "rule",
                "color": "red"
            },
            "encoding": {
                "x": {
                    "field": "__x1",
                    "type": "quantitative",
                    "title": "theoretical",
                    "scale": {
                        "zero": false
                    }
                },
                "x2": {
                    "field": "__x2"
                },
                "y": {
                    "field": "__y1",
                    "type": "quantitative",
                    "title": "y",
                    "scale": {
                        "zero": false
                    }
                },
                "y2": {
                    "field": "__y2"
                }
            }
        }
    ]
}
