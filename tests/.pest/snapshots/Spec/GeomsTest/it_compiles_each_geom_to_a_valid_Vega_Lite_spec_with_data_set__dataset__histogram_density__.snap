{
    "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
    "data": {
        "values": [
            {
                "x": 1,
                "y": 2.5,
                "g": "a",
                "h": "p",
                "n": 3,
                "date": "2024-01-01",
                "lo": 2.0,
                "hi": 3.0
            },
            {
                "x": 2,
                "y": 3.1,
                "g": "b",
                "h": "q",
                "n": 5,
                "date": "2024-02-01",
                "lo": 2.6,
                "hi": 3.7
            },
            {
                "x": 3,
                "y": 2.2,
                "g": "a",
                "h": "q",
                "n": 2,
                "date": "2024-03-01",
                "lo": 1.5,
                "hi": 2.9
            },
            "... 3 more rows"
        ]
    },
    "layer": [
        {
            "transform": [
                {
                    "bin": {
                        "maxbins": 5
                    },
                    "field": "y",
                    "as": [
                        "__bin_start",
                        "__bin_end"
                    ]
                },
                {
                    "aggregate": [
                        {
                            "op": "count",
                            "as": "__count"
                        }
                    ],
                    "groupby": [
                        "__bin_start",
                        "__bin_end"
                    ]
                },
                {
                    "joinaggregate": [
                        {
                            "op": "sum",
                            "field": "__count",
                            "as": "__total"
                        }
                    ],
                    "groupby": []
                },
                {
                    "calculate": "datum.__count / datum.__total / (datum.__bin_end - datum.__bin_start)",
                    "as": "density"
                }
            ],
            "mark": {
                "type": "bar"
            },
            "encoding": {
                "x": {
                    "field": "__bin_start",
                    "type": "quantitative",
                    "bin": {
                        "binned": true
                    },
                    "title": "y"
                },
                "x2": {
                    "field": "__bin_end"
                },
                "y": {
                    "field": "density",
                    "type": "quantitative",
                    "title": "density"
                }
            }
        },
        {
            "transform": [
                {
                    "density": "y",
                    "as": [
                        "y",
                        "density"
                    ]
                }
            ],
            "mark": {
                "type": "line"
            },
            "encoding": {
                "x": {
                    "field": "y",
                    "type": "quantitative"
                },
                "y": {
                    "field": "density",
                    "type": "quantitative",
                    "title": "density"
                }
            }
        }
    ]
}
