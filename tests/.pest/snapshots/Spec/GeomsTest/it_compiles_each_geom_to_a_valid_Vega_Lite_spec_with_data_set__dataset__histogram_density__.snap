{
    "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
    "data": {
        "values": [
            {
                "x": 1,
                "y": 2.5,
                "g": "a",
                "h": "p",
                "n": 3,
                "date": "2024-01-01",
                "lo": 2.0,
                "hi": 3.0
            },
            {
                "x": 2,
                "y": 3.1,
                "g": "b",
                "h": "q",
                "n": 5,
                "date": "2024-02-01",
                "lo": 2.6,
                "hi": 3.7
            },
            {
                "x": 3,
                "y": 2.2,
                "g": "a",
                "h": "q",
                "n": 2,
                "date": "2024-03-01",
                "lo": 1.5,
                "hi": 2.9
            },
            "... 3 more rows"
        ]
    },
    "layer": [
        {
            "transform": [
                {
                    "bin": {
                        "maxbins": 5
                    },
                    "field": "y",
                    "as": [
                        "__bin_start",
                        "__bin_end"
                    ]
                },
                {
                    "aggregate": [
                        {
                            "op": "count",
                            "as": "__count"
                        }
                    ],
                    "groupby": [
                        "__bin_start",
                        "__bin_end"
                    ]
                },
                {
                    "joinaggregate": [
                        {
                            "op": "sum",
                            "field": "__count",
                            "as": "__total"
                        }
                    ],
                    "groupby": []
                },
                {
                    "calculate": "datum.__count / datum.__total / (datum.__bin_end - datum.__bin_start)",
                    "as": "density"
                }
            ],
            "mark": {
                "type": "bar"
            },
            "encoding": {
                "x": {
                    "field": "__bin_start",
                    "type": "quantitative",
                    "bin": {
                        "binned": true
                    },
                    "title": "y"
                },
                "x2": {
                    "field": "__bin_end"
                },
                "y": {
                    "field": "density",
                    "type": "quantitative",
                    "title": "density"
                }
            }
        },
        {
            "transform": [
                {
                    "density": "y",
                    "as": [
                        "y",
                        "density"
                    ]
                }
            ],
            "mark": {
                "type": "line"
            },
            "encoding": {
                "x": {
                    "field": "y",
                    "type": "quantitative"
                },
                "y": {
                    "field": "density",
                    "type": "quantitative",
                    "title": "density"
                }
            }
        }
    ],
    "config": {
        "axisQuantitative": {
            "tickCount": 5
        },
        "style": {
            "phiz-fit": {
                "color": "#3366FF"
            },
            "phiz-band": {
                "color": "#999999",
                "opacity": 0.4
            }
        }
    },
    "usermeta": {
        "phiz": {
            "dark": {
                "background": "transparent",
                "view": {
                    "fill": null,
                    "stroke": "#3F3F46"
                },
                "axis": {
                    "gridColor": "rgba(255, 255, 255, 0.12)",
                    "gridOpacity": 1,
                    "domainColor": "#71717A",
                    "tickColor": "#71717A",
                    "labelColor": "#A1A1AA",
                    "titleColor": "#E4E4E7"
                },
                "legend": {
                    "labelColor": "#E4E4E7",
                    "titleColor": "#E4E4E7"
                },
                "header": {
                    "labelColor": "#E4E4E7",
                    "titleColor": "#E4E4E7"
                },
                "title": {
                    "color": "#E4E4E7",
                    "subtitleColor": "#A1A1AA"
                },
                "mark": {
                    "color": "#8AB4F8"
                },
                "point": {
                    "color": "#8AB4F8"
                },
                "line": {
                    "color": "#8AB4F8"
                },
                "text": {
                    "color": "#E4E4E7"
                },
                "rule": {
                    "color": "#A1A1AA"
                },
                "style": {
                    "phiz-fit": {
                        "color": "#A5C8FF"
                    },
                    "phiz-band": {
                        "color": "#FFFFFF",
                        "opacity": 0.16
                    }
                }
            }
        }
    }
}
