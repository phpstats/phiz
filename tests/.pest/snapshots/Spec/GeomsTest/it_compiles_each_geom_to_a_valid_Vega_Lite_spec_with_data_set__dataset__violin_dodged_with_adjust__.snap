{
    "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
    "width": 300,
    "data": {
        "values": []
    },
    "mark": {
        "type": "trail",
        "opacity": 0.7
    },
    "encoding": {
        "x": {
            "field": "h",
            "type": "nominal"
        },
        "color": {
            "field": "g",
            "type": "nominal"
        },
        "y": {
            "field": "y",
            "type": "quantitative",
            "title": "y",
            "scale": {
                "zero": false
            }
        },
        "size": {
            "field": "__width",
            "type": "quantitative",
            "scale": {
                "domain": [
                    0,
                    1
                ],
                "range": [
                    0,
                    20.0
                ]
            },
            "legend": null
        },
        "order": {
            "field": "y",
            "type": "quantitative"
        },
        "detail": [
            {
                "field": "h",
                "type": "nominal"
            }
        ],
        "xOffset": {
            "field": "g",
            "type": "nominal"
        }
    },
    "config": {
        "legend": {
            "labelLimit": 320
        }
    }
}
