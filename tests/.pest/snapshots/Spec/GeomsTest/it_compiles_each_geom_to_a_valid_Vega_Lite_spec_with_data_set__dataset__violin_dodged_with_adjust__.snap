{
    "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
    "data": {
        "values": [
            {
                "x": 1,
                "y": 2.5,
                "g": "a",
                "h": "p",
                "n": 3,
                "date": "2024-01-01",
                "lo": 2.0,
                "hi": 3.0
            },
            {
                "x": 2,
                "y": 3.1,
                "g": "b",
                "h": "q",
                "n": 5,
                "date": "2024-02-01",
                "lo": 2.6,
                "hi": 3.7
            },
            {
                "x": 3,
                "y": 2.2,
                "g": "a",
                "h": "q",
                "n": 2,
                "date": "2024-03-01",
                "lo": 1.5,
                "hi": 2.9
            },
            "... 3 more rows"
        ]
    },
    "width": 300,
    "transform": [
        {
            "density": "y",
            "groupby": [
                "h",
                "g"
            ],
            "as": [
                "y",
                "__density"
            ],
            "bandwidth": 1.5345147991689796
        },
        {
            "joinaggregate": [
                {
                    "op": "max",
                    "field": "__density",
                    "as": "__peak"
                }
            ],
            "groupby": [
                "h",
                "g"
            ]
        },
        {
            "calculate": "datum.__density / datum.__peak",
            "as": "__width"
        }
    ],
    "mark": {
        "type": "trail",
        "opacity": 0.7
    },
    "encoding": {
        "x": {
            "field": "h",
            "type": "nominal"
        },
        "color": {
            "field": "g",
            "type": "nominal"
        },
        "y": {
            "field": "y",
            "type": "quantitative",
            "title": "y",
            "scale": {
                "zero": false
            }
        },
        "size": {
            "field": "__width",
            "type": "quantitative",
            "scale": {
                "domain": [
                    0,
                    1
                ],
                "range": [
                    0,
                    60.0
                ]
            },
            "legend": null
        },
        "order": {
            "field": "y",
            "type": "quantitative"
        },
        "detail": [
            {
                "field": "h",
                "type": "nominal"
            }
        ],
        "xOffset": {
            "field": "g",
            "type": "nominal"
        }
    },
    "config": {
        "legend": {
            "labelLimit": 320
        }
    }
}
