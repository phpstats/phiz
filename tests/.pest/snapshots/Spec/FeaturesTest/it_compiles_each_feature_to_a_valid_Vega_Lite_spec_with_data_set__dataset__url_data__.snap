{
    "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
    "data": {
        "url": "https://vega.github.io/vega-datasets/data/cars.json"
    },
    "mark": {
        "type": "point",
        "filled": true
    },
    "encoding": {
        "x": {
            "field": "Horsepower",
            "type": "quantitative",
            "scale": {
                "zero": false
            }
        },
        "y": {
            "field": "Miles_per_Gallon",
            "type": "quantitative",
            "scale": {
                "zero": false
            }
        },
        "color": {
            "field": "Origin",
            "type": "nominal"
        }
    },
    "config": {
        "legend": {
            "labelLimit": 320
        }
    }
}
