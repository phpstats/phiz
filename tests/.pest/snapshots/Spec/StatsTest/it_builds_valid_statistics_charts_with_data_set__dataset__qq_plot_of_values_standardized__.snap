{
    "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
    "title": "Normal QQ",
    "data": {
        "values": [
            {
                "sample": 0.7076731463403723
            },
            {
                "sample": -0.6510592946331425
            },
            {
                "sample": -0.056613851707229775
            },
            "... 3 more rows"
        ]
    },
    "layer": [
        {
            "transform": [
                {
                    "filter": "isValid(datum[\"sample\"]) && isFinite(datum[\"sample\"])"
                },
                {
                    "window": [
                        {
                            "op": "row_number",
                            "as": "__rank"
                        }
                    ],
                    "sort": [
                        {
                            "field": "sample"
                        }
                    ]
                },
                {
                    "joinaggregate": [
                        {
                            "op": "count",
                            "as": "__n"
                        }
                    ]
                },
                {
                    "calculate": "datum.__n <= 10 ? (datum.__rank - 0.375) / (datum.__n + 0.25) : (datum.__rank - 0.5) / datum.__n",
                    "as": "__prob"
                },
                {
                    "calculate": "quantileNormal(datum.__prob)",
                    "as": "theoretical"
                },
                {
                    "joinaggregate": [
                        {
                            "op": "q1",
                            "field": "sample",
                            "as": "__q1"
                        },
                        {
                            "op": "q3",
                            "field": "sample",
                            "as": "__q3"
                        }
                    ]
                },
                {
                    "calculate": "(datum.__q3 - datum.__q1) / (quantileNormal(0.75) - quantileNormal(0.25))",
                    "as": "__slope"
                },
                {
                    "calculate": "datum.__q1 - datum.__slope * quantileNormal(0.25)",
                    "as": "__intercept"
                },
                {
                    "aggregate": [
                        {
                            "op": "min",
                            "field": "theoretical",
                            "as": "__x1"
                        },
                        {
                            "op": "max",
                            "field": "theoretical",
                            "as": "__x2"
                        }
                    ],
                    "groupby": [
                        "__slope",
                        "__intercept"
                    ]
                },
                {
                    "calculate": "datum.__intercept + datum.__slope * datum.__x1",
                    "as": "__y1"
                },
                {
                    "calculate": "datum.__intercept + datum.__slope * datum.__x2",
                    "as": "__y2"
                }
            ],
            "mark": {
                "type": "rule",
                "color": "#888888",
                "strokeDash": [
                    4,
                    4
                ]
            },
            "encoding": {
                "x": {
                    "field": "__x1",
                    "type": "quantitative",
                    "title": "Theoretical quantiles",
                    "scale": {
                        "zero": false
                    }
                },
                "x2": {
                    "field": "__x2"
                },
                "y": {
                    "field": "__y1",
                    "type": "quantitative",
                    "title": "Standardized sample",
                    "scale": {
                        "zero": false
                    }
                },
                "y2": {
                    "field": "__y2"
                }
            }
        },
        {
            "transform": [
                {
                    "filter": "isValid(datum[\"sample\"]) && isFinite(datum[\"sample\"])"
                },
                {
                    "window": [
                        {
                            "op": "row_number",
                            "as": "__rank"
                        }
                    ],
                    "sort": [
                        {
                            "field": "sample"
                        }
                    ]
                },
                {
                    "joinaggregate": [
                        {
                            "op": "count",
                            "as": "__n"
                        }
                    ]
                },
                {
                    "calculate": "datum.__n <= 10 ? (datum.__rank - 0.375) / (datum.__n + 0.25) : (datum.__rank - 0.5) / datum.__n",
                    "as": "__prob"
                },
                {
                    "calculate": "quantileNormal(datum.__prob)",
                    "as": "theoretical"
                }
            ],
            "mark": {
                "type": "point",
                "filled": true,
                "opacity": 0.7
            },
            "encoding": {
                "x": {
                    "field": "theoretical",
                    "type": "quantitative",
                    "title": "Theoretical quantiles",
                    "scale": {
                        "zero": false
                    }
                },
                "y": {
                    "field": "sample",
                    "type": "quantitative",
                    "title": "Standardized sample",
                    "scale": {
                        "zero": false
                    }
                }
            }
        }
    ]
}
