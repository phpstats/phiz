                            "title": "Fitted values"
                        },
                        "y": {
                            "field": "observed",
                            "type": "quantitative",
                            "scale": {
                                "zero": false
                            },
                            "title": "Observed"
                        }
                    }
                },
                {
                    "transform": [
                        {
                            "aggregate": [
                                {
                                    "op": "min",
                                    "field": "fitted",
                                    "as": "__x1"
                                },
                                {
                                    "op": "max",
                                    "field": "fitted",
                                    "as": "__x2"
                                }
                            ]
                        },
                        {
                            "calculate": "0 + 1 * datum.__x1",
                            "as": "__y1"
                        },
                        {
                            "calculate": "0 + 1 * datum.__x2",
                            "as": "__y2"
                        }
                    ],
