                        "opacity": 0.6
                    },
                    "encoding": {
                        "x": {
                            "field": "fitted",
                            "type": "quantitative",
                            "scale": {
                                "zero": false
                            },
                            "title": "Fitted values"
                        },
                        "y": {
                            "field": "root_abs",
                            "type": "quantitative",
                            "scale": {
                                "zero": false
                            },
                            "title": "√|standardized residual|"
                        }
                    }
                },
                {
                    "transform": [
                        {
                            "loess": "root_abs",
                            "on": "fitted",
                            "bandwidth": 0.75,
                            "as": [
