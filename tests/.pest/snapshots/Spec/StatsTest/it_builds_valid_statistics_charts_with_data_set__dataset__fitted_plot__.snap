            "... 29 more rows"
        ]
    },
    "layer": [
        {
            "mark": {
                "type": "point",
                "filled": true,
                "opacity": 0.6
            },
            "encoding": {
                "x": {
                    "field": "fitted",
                    "type": "quantitative",
                    "title": "Fitted values",
                    "scale": {
                        "zero": false
                    }
                },
                "y": {
                    "field": "observed",
                    "type": "quantitative",
                    "title": "Observed",
                    "scale": {
                        "zero": false
                    }
                }
            }
        },
        {
            "transform": [
                {
                    "aggregate": [
                        {
                            "op": "min",
                            "field": "fitted",
                            "as": "__x1"
                        },
                        {
                            "op": "max",
                            "field": "fitted",
                            "as": "__x2"
                        }
                    ]
                },
                {
                    "calculate": "0 + 1 * datum.__x1",
                    "as": "__y1"
                },
                {
                    "calculate": "0 + 1 * datum.__x2",
                    "as": "__y2"
                }
            ],
            "mark": {
                "type": "rule",
                "color": "#888888",
                "strokeDash": [
                    4,
                    4
                ]
            },
            "encoding": {
                "x": {
                    "field": "__x1",
                    "type": "quantitative",
                    "title": "Fitted values",
                    "scale": {
                        "zero": false
                    }
                },
                "x2": {
                    "field": "__x2"
                },
                "y": {
                    "field": "__y1",
                    "type": "quantitative",
                    "title": "Observed",
                    "scale": {
                        "zero": false
                    }
                },
                "y2": {
                    "field": "__y2"
                }
            }
        }
    ],
    "config": {
        "axisQuantitative": {
            "tickCount": 5
        },
        "style": {
            "phiz-fit": {
