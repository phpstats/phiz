{
    "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
    "title": "Normal QQ",
    "data": {
        "values": [
            {
                "sample": -0.6085128099612014
            },
            {
                "sample": 0.2027452219421022
            },
            {
                "sample": -3.514995675526734
            },
            "... 29 more rows"
        ]
    },
    "layer": [
        {
            "transform": [
                {
                    "quantile": "sample",
                    "as": [
                        "__prob",
                        "sample"
                    ],
                    "step": 0.03125
                },
                {
                    "calculate": "quantileNormal(datum.__prob)",
                    "as": "theoretical"
                },
                {
                    "joinaggregate": [
                        {
                            "op": "q1",
                            "field": "sample",
                            "as": "__q1"
                        },
                        {
                            "op": "q3",
                            "field": "sample",
                            "as": "__q3"
                        }
                    ]
                },
                {
                    "calculate": "(datum.__q3 - datum.__q1) / (quantileNormal(0.75) - quantileNormal(0.25))",
                    "as": "__slope"
                },
                {
                    "calculate": "datum.__q1 - datum.__slope * quantileNormal(0.25)",
                    "as": "__intercept"
                },
                {
                    "aggregate": [
                        {
                            "op": "min",
                            "field": "theoretical",
                            "as": "__x1"
                        },
                        {
                            "op": "max",
                            "field": "theoretical",
                            "as": "__x2"
                        }
                    ],
                    "groupby": [
                        "__slope",
                        "__intercept"
                    ]
                },
                {
                    "calculate": "datum.__intercept + datum.__slope * datum.__x1",
                    "as": "__y1"
                },
                {
                    "calculate": "datum.__intercept + datum.__slope * datum.__x2",
                    "as": "__y2"
                }
            ],
            "mark": {
                "type": "rule",
                "color": "#888888",
                "strokeDash": [
                    4,
                    4
                ]
            },
            "encoding": {
                "x": {
                    "field": "__x1",
                    "type": "quantitative",
                    "title": "Theoretical quantiles",
                    "scale": {
                        "zero": false
                    }
                },
                "x2": {
                    "field": "__x2"
                },
                "y": {
                    "field": "__y1",
                    "type": "quantitative",
                    "title": "Residuals",
                    "scale": {
                        "zero": false
                    }
                },
                "y2": {
                    "field": "__y2"
                }
            }
        },
        {
            "transform": [
                {
                    "quantile": "sample",
                    "as": [
                        "__prob",
                        "sample"
                    ],
                    "step": 0.03125
                },
                {
                    "calculate": "quantileNormal(datum.__prob)",
                    "as": "theoretical"
                }
            ],
            "mark": {
                "type": "point",
                "filled": true,
                "opacity": 0.7
            },
            "encoding": {
                "x": {
                    "field": "theoretical",
                    "type": "quantitative",
                    "title": "Theoretical quantiles",
                    "scale": {
                        "zero": false
                    }
                },
                "y": {
                    "field": "sample",
                    "type": "quantitative",
                    "title": "Residuals",
                    "scale": {
                        "zero": false
                    }
                }
            }
        }
    ]
}
